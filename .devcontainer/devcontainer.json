// Lets a player work this sprint entirely in the browser, through GitHub
// Codespaces, with the stack's toolchain already installed.
//
// Grading always runs in WorkSim's own sandbox, never here, so this is not
// what makes a submission gradeable. It exists so a player can run the suite
// BEFORE opening the PR. Without it, anyone without a local toolchain codes
// blind, fails more first passes, and is scored lower for it.
//
// Run the suite in the Codespace terminal with:
//   mvn -B test
{
  "name": "WorkSim: Corebank (Java/Maven)",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    }
  },
  "postCreateCommand": "mvn -B -q dependency:go-offline"
}
